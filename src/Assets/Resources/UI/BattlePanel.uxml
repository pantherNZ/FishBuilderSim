<ui:UXML xmlns:ui="UnityEngine.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/UI/BattlePanel.uss?fileID=7433441132597879392&amp;guid=60e10b4a87df4dd48b433b297c7335b9&amp;type=3#BattlePanel"/>
    <ui:VisualElement name="bp-root" class="bp-root">
        <ui:VisualElement name="bp-arena" class="bp-arena">
            <ui:VisualElement name="bp-health-bar-layer" class="bp-health-bar-layer"/>
            <ui:VisualElement name="bp-species-visual-layer" picking-mode="Ignore" class="bp-species-visual-layer"/>
            <ui:VisualElement name="bp-player-species-strip" class="bp-species-strip bp-species-strip--player"/>
            <ui:VisualElement name="bp-enemy-species-strip" class="bp-species-strip bp-species-strip--enemy"/>
        </ui:VisualElement>
        <ui:VisualElement name="bp-energy-counter" class="bp-energy-counter" style="bottom: 352px; left: 1px; width: 129px; height: 119px;">
            <ui:Label text="CURRENT ENERGY" class="bp-energy-counter__label"/>
            <ui:VisualElement class="bp-energy-counter__value-row">
                <ui:Label name="bp-energy-value" text="—" class="bp-energy-counter__value"/>
                <ui:Label text="/ 5" class="bp-energy-counter__maximum"/>
            </ui:VisualElement>
            <ui:Label name="bp-energy-species" text="SELECT ORGANISM" class="bp-energy-counter__species"/>
        </ui:VisualElement>
        <ui:VisualElement name="bp-action-tray" class="bp-action-tray" style="height: 25%; bottom: 0;">
            <ui:VisualElement name="bp-turn-header" class="bp-turn-header">
                <ui:Label name="bp-round-label" text="TURN 1 - PLAYER TURN" class="bp-round-label"/>
                <ui:Button name="bp-end-turn-btn" text="END TURN" tooltip="Finish your turn. Unspent energy is lost; each organism refreshes to 5 energy next turn." class="bp-end-turn-btn" style="white-space: normal; flex-direction: row; align-self: center; font-size: 20px; height: 50px; width: 180px;"/>
            </ui:VisualElement>
            <ui:Label text="COMBAT LOG" class="bp-tray-label bp-tray-label--log" style="font-size: 20px;"/>
            <ui:ScrollView name="bp-log-scroll" horizontal-scroller-visibility="Hidden" class="bp-log-scroll" style="height: 200px;">
                <ui:VisualElement name="bp-log-list" class="bp-log-list"/>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="bp-species-info" picking-mode="Ignore" class="bp-species-info bp-hidden">
            <ui:Label name="bp-info-name" text="—" class="bp-info-name"/>
            <ui:VisualElement class="bp-info-stats">
                <ui:VisualElement class="bp-stat-row">
                    <ui:Label text="HEALTH" class="bp-stat-label"/>
                    <ui:Label name="bp-info-hp" text="—" class="bp-stat-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="bp-stat-row">
                    <ui:Label text="ATTACK" class="bp-stat-label"/>
                    <ui:Label name="bp-info-atk" text="—" class="bp-stat-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="bp-stat-row">
                    <ui:Label text="DEFENCE" class="bp-stat-label"/>
                    <ui:Label name="bp-info-def" text="—" class="bp-stat-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="bp-stat-row">
                    <ui:Label text="SIZE" class="bp-stat-label"/>
                    <ui:Label name="bp-info-size" text="—" class="bp-stat-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="bp-stat-row">
                    <ui:Label text="STRENGTH" class="bp-stat-label"/>
                    <ui:Label name="bp-info-strength" text="—" class="bp-stat-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="bp-stat-row">
                    <ui:Label text="FORAGE" class="bp-stat-label"/>
                    <ui:Label name="bp-info-forage" text="—" class="bp-stat-value"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label text="BEHAVIORS" class="bp-info-section-header"/>
            <ui:VisualElement name="bp-info-behaviors" class="bp-info-behaviors"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
