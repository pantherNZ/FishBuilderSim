<ui:UXML xmlns:ui="UnityEngine.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/UI/BattlePanel.uss?fileID=7433441132597879392&amp;guid=60e10b4a87df4dd48b433b297c7335b9&amp;type=3#BattlePanel"/>
    <ui:VisualElement name="bp-root" class="bp-root">
        <ui:VisualElement name="bp-arena" class="bp-arena">
            <ui:VisualElement name="bp-player-species-strip" class="bp-species-strip bp-species-strip--player"/>
            <ui:VisualElement name="bp-enemy-species-strip" class="bp-species-strip bp-species-strip--enemy"/>
            <ui:VisualElement name="bp-action-popup" class="bp-action-popup bp-hidden">
                <ui:Label name="bp-action-popup-title" text="SELECT AN ACTION" class="bp-action-popup__title"/>
                <ui:VisualElement name="bp-action-popup-actions" class="bp-action-popup__actions"/>
            </ui:VisualElement>
            <ui:VisualElement name="bp-health-bar-layer" picking-mode="Ignore" class="bp-health-bar-layer"/>
            <ui:Button name="bp-begin-btn" text="BEGIN" class="bp-begin-btn"/>
        </ui:VisualElement>
        <ui:VisualElement name="bp-action-tray" class="bp-action-tray" style="height: 350px;">
            <ui:Label name="bp-round-label" text="ROUND 1 / 10 - PLAYER TURN" class="bp-round-label"/>
            <ui:VisualElement name="bp-size-scoreboard" class="bp-size-scoreboard">
                <ui:VisualElement class="bp-size-score">
                    <ui:Label text="YOUR SIZE" class="bp-size-score__label"/>
                    <ui:Label name="bp-player-total-size" text="0" class="bp-size-score__value bp-size-score__value--player"/>
                </ui:VisualElement>
                <ui:Label name="bp-size-lead" text="TIED" class="bp-size-lead bp-size-lead--tie"/>
                <ui:VisualElement class="bp-size-score">
                    <ui:Label text="ENEMY SIZE" class="bp-size-score__label"/>
                    <ui:Label name="bp-enemy-total-size" text="0" class="bp-size-score__value bp-size-score__value--enemy"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label text="COMBAT LOG" class="bp-tray-label"/>
            <ui:ScrollView name="bp-log-scroll" horizontal-scroller-visibility="Hidden" class="bp-log-scroll">
                <ui:VisualElement name="bp-log-list" class="bp-log-list"/>
            </ui:ScrollView>
            <ui:Label text="YOUR PARTS" class="bp-tray-label bp-tray-label--parts"/>
            <ui:VisualElement name="bp-card-row" class="bp-card-row"/>
        </ui:VisualElement>
        <ui:VisualElement name="bp-species-info" class="bp-species-info bp-hidden">
            <ui:Label name="bp-info-name" text="—" class="bp-info-name"/>
            <ui:VisualElement class="bp-info-stats">
                <ui:VisualElement class="bp-stat-row">
                    <ui:Label text="HP" class="bp-stat-label"/>
                    <ui:Label name="bp-info-hp" text="—" class="bp-stat-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="bp-stat-row">
                    <ui:Label text="ATK" class="bp-stat-label"/>
                    <ui:Label name="bp-info-atk" text="—" class="bp-stat-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="bp-stat-row">
                    <ui:Label text="DEF" class="bp-stat-label"/>
                    <ui:Label name="bp-info-def" text="—" class="bp-stat-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="bp-stat-row">
                    <ui:Label text="SIZE" class="bp-stat-label"/>
                    <ui:Label name="bp-info-size" text="—" class="bp-stat-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="bp-stat-row">
                    <ui:Label text="FORAGE" class="bp-stat-label"/>
                    <ui:Label name="bp-info-forage" text="—" class="bp-stat-value"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label text="BEHAVIORS" class="bp-info-section-header"/>
            <ui:VisualElement name="bp-info-behaviors" class="bp-info-behaviors"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
