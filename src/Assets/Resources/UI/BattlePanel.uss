/* =========================================================
   Battle Panel — USS stylesheet
   Follows the same dark-aquatic theme as the other panels.
   ========================================================= */

/* ── Utility ──────────────────────────────────────────────── */
.bp-hidden {
    display: none;
}

/* ── Root ─────────────────────────────────────────────────── */
.bp-root {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    flex-direction: column;
}

/* ── Arena ────────────────────────────────────────────────── */
.bp-arena {
    flex: 1;
    position: relative; /* needed for absolute children */
    align-items: center;
    justify-content: center;
}

/* Layer that health bars are parented to; covers the full arena */
.bp-health-bar-layer {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.bp-species-visual-layer {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.bp-species-visual {
    position: absolute;
    border-radius: 50%;
    border-width: 2px;
    border-color: rgba(80, 165, 205, 0.8);
    background-color: rgba(12, 38, 58, 0.72);
    transition-property: width, height, left, top, opacity;
    transition-duration: 0.2s;
}
.bp-species-visual--targetable {
    border-color: rgb(245, 175, 85);
    background-color: rgba(110, 58, 24, 0.78);
}
.bp-species-visual--targetable:hover {
    border-color: rgb(255, 225, 130);
    background-color: rgba(145, 78, 28, 0.86);
}
.bp-species-visual--targeted {
    border-color: rgb(255, 225, 130);
    background-color: rgba(155, 82, 28, 0.9);
}
.bp-defense-indicator {
    position: absolute;
    width: 58px;
    height: 28px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-left: 5px;
    padding-right: 7px;
    border-width: 1px;
    border-color: rgba(115, 190, 225, 0.9);
    border-radius: 14px;
    background-color: rgba(8, 28, 48, 0.96);
}
.bp-defense-indicator__icon {
    width: 20px;
    color: rgb(125, 210, 245);
    font-size: 15px;
    -unity-text-align: middle-center;
}
.bp-defense-indicator__count {
    margin-left: 2px;
    color: rgb(160, 240, 255);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.bp-target-line {
    position: absolute;
    height: 4px;
    min-height: 4px;
    border-radius: 2px;
    background-color: rgb(255, 202, 100);
    border-color: rgba(255, 236, 170, 0.9);
    border-width: 1px;
}
.bp-target-line__arrow {
    position: absolute;
    right: -11px;
    top: -10px;
    width: 20px;
    height: 24px;
    color: rgb(255, 225, 130);
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.bp-action-tooltip {
    position: absolute;
    width: 240px;
    flex-direction: column;
    padding: 8px 10px;
    border-width: 1px;
    border-color: rgb(70, 145, 190);
    border-radius: 6px;
    background-color: rgba(8, 24, 42, 0.98);
}

.bp-action-tooltip__title {
    margin-bottom: 4px;
    color: rgb(220, 240, 255);
    font-size: 12px;
    -unity-font-style: bold;
    white-space: normal;
}

.bp-action-tooltip__description {
    color: rgb(165, 205, 230);
    font-size: 10px;
    white-space: normal;
}

/* ── Action card tray ─────────────────────────────────────── */
.bp-action-tray {
    position: relative;
    height: 300px;
    min-height: 300px;
    flex-direction: column;
    padding: 8px 16px 12px;
    background-color: rgba(5, 12, 25, 0.92);
    border-top-color: rgb(30, 80, 120);
    border-top-width: 2px;
}

.bp-tray-label {
    font-size: 10px;
    color: rgb(70, 120, 170);
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 8px;
}

.bp-tray-label--log {
    margin-top: auto;
    margin-left: 0;
}

.bp-energy-counter {
    position: absolute;
    left: 16px;
    bottom: 12px;
    width: 148px;
    height: 112px;
    padding: 8px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: rgb(70, 145, 190);
    border-radius: 8px;
    background-color: rgba(8, 24, 42, 0.96);
}

.bp-energy-counter__label {
    color: rgb(120, 200, 235);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.bp-energy-counter__value-row {
    flex-direction: row;
    align-items: baseline;
    margin-top: 2px;
}

.bp-energy-counter__value {
    color: rgb(120, 245, 205);
    font-size: 42px;
    -unity-font-style: bold;
}

.bp-energy-counter__maximum {
    margin-left: 3px;
    color: rgb(145, 190, 215);
    font-size: 18px;
}

.bp-energy-counter__species {
    max-width: 100%;
    margin-top: 2px;
    color: rgb(165, 205, 230);
    font-size: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.bp-round-label {
    font-size: 11px;
    color: rgb(120, 210, 255);
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 8px;
}

.bp-log-scroll {
    min-height: 120px;
    height: 120px;
    flex-shrink: 0;
    margin-left: 0;
    margin-bottom: 0;
    border-width: 1px;
    border-color: rgba(35, 85, 125, 0.65);
    border-radius: 6px;
    background-color: rgba(8, 22, 40, 0.85);
    padding: 6px 8px;
}

.bp-log-list {
    flex-direction: column;
}

.bp-log-entry {
    font-size: 10px;
    color: rgb(150, 205, 240);
    white-space: normal;
    margin-bottom: 3px;
}

.bp-species-strip {
    position: absolute;
    top: 14px;
    flex-direction: row;
    align-items: flex-start;
}

.bp-species-strip--player {
    left: 14px;
}

.bp-species-strip--enemy {
    right: 250px;
}

.bp-species-chip {
    width: 74px;
    margin-right: 8px;
    padding: 6px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(40, 95, 140, 0.8);
    background-color: rgba(10, 25, 45, 0.85);
    align-items: center;
}

.bp-species-chip--dead {
    opacity: 0.4;
}

.bp-species-chip--selectable {
    transition-property: border-color, background-color, translate;
    transition-duration: 0.12s;
}
.bp-species-chip--selectable:hover {
    border-color: rgb(95, 185, 225);
    background-color: rgba(18, 50, 78, 0.95);
    translate: 0 -2px;
}
.bp-species-chip--selected {
    border-color: rgb(80, 210, 150);
    background-color: rgba(18, 70, 52, 0.95);
}

.bp-action-popup {
    position: absolute;
    top: 104px;
    left: 14px;
    width: 220px;
    padding: 10px 12px;
    border-width: 2px;
    border-color: rgb(55, 145, 135);
    border-radius: 8px;
    background-color: rgba(6, 24, 34, 0.96);
}
.bp-action-popup__title {
    font-size: 9px;
    color: rgb(140, 230, 205);
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 8px;
    white-space: normal;
}
.bp-action-popup__actions {
    flex-direction: row;
}
.bp-action-popup__action-btn {
    min-width: 58px;
    height: 26px;
    margin-right: 5px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(45, 125, 135);
    background-color: rgba(12, 52, 66, 0.95);
    color: rgb(155, 225, 235);
    font-size: 8px;
    -unity-font-style: bold;
}
.bp-action-popup__action-btn:hover {
    border-color: rgb(105, 225, 195);
    background-color: rgba(22, 88, 78, 0.95);
}
.bp-action-popup__action-btn--selected {
    border-color: rgb(95, 225, 155);
    background-color: rgba(25, 105, 70, 0.95);
    color: rgb(175, 245, 195);
}
.bp-action-popup__empty {
    font-size: 9px;
    color: rgb(175, 145, 125);
}

.bp-species-chip__portrait {
    width: 48px;
    height: 48px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(80, 145, 195, 0.85);
    background-color: rgba(20, 45, 70, 0.85);
    margin-bottom: 4px;
}

.bp-species-chip__name {
    font-size: 8px;
    color: rgb(160, 215, 250);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    white-space: normal;
}

.bp-species-chip__hp {
    font-size: 8px;
    color: rgb(125, 185, 220);
    -unity-text-align: upper-center;
}

.bp-species-chip__size {
    font-size: 8px;
    color: rgb(230, 190, 105);
    -unity-text-align: upper-center;
}

/* ── Action cards ─────────────────────────────────────────── */
.bp-action-card {
    width: 100px;
    height: 120px;
    margin-right: 12px;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(40, 100, 150);
    background-color: rgba(12, 35, 60, 0.95);
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 6px;
    transition-property: border-color, background-color, translate;
    transition-duration: 0.12s;
}
.bp-action-card:hover {
    border-color: rgb(80, 160, 240);
    background-color: rgba(20, 60, 100, 0.95);
    translate: 0 -4px;
}
.bp-action-card--played {
    opacity: 0.35;
    border-color: rgb(25, 55, 85);
    translate: 0 4px;
}

.bp-action-card__icon {
    width: 56px;
    height: 56px;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0.35);
    margin-bottom: 6px;
}
.bp-action-card__name {
    font-size: 9px;
    color: rgb(200, 230, 255);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    white-space: normal;
    overflow: hidden;
    margin-bottom: 4px;
    padding: 0 2px;
}
.bp-action-card__stats {
    font-size: 8px;
    color: rgb(100, 160, 210);
    -unity-text-align: upper-center;
    white-space: normal;
}

/* ── Species info overlay ─────────────────────────────────── */
.bp-species-info {
    position: absolute;
    top: 16px;
    right: auto;
    width: 220px;
    background-color: rgba(8, 18, 30, 0.94);
    border-color: rgb(30, 80, 120);
    border-width: 2px;
    border-radius: 10px;
    padding: 14px 16px;
}

.bp-info-name {
    font-size: 14px;
    color: rgb(120, 200, 255);
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 10px;
}

.bp-info-stats {
    margin-bottom: 8px;
}

.bp-stat-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 4px;
}
.bp-stat-label {
    font-size: 11px;
    color: rgb(70, 120, 170);
    -unity-font-style: bold;
    letter-spacing: 1px;
}
.bp-stat-value {
    font-size: 11px;
    color: rgb(200, 230, 255);
}

.bp-info-section-header {
    font-size: 9px;
    color: rgb(70, 120, 170);
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 6px;
    margin-top: 8px;
    border-top-color: rgb(25, 60, 100);
    border-top-width: 1px;
    padding-top: 8px;
}

.bp-info-behaviors {
    flex-direction: column;
}
.bp-behavior-tag {
    font-size: 10px;
    color: rgb(160, 220, 180);
    background-color: rgba(20, 60, 30, 0.65);
    border-radius: 3px;
    padding: 2px 6px;
    margin-bottom: 3px;
}

/* ── Floating health bars ─────────────────────────────────── */
.bp-health-bar {
    width: 400px;
    flex-direction: column;
    align-items: stretch;
}
.bp-health-bar__status-effects {
    position: absolute;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    min-height: 24px;
    padding: 2px;
    border-radius: 5px;
    background-color: rgba(5, 15, 25, 0.78);
}
.bp-health-bar__status-icon {
    width: 22px;
    height: 22px;
    margin-left: 2px;
    margin-right: 2px;
    padding: 2px;
    border-width: 1px;
    border-color: rgba(185, 100, 100, 0.9);
    border-radius: 4px;
    background-color: rgba(85, 30, 35, 0.92);
    color: rgb(255, 205, 185);
    -unity-text-align: middle-center;
}
.bp-health-bar__status-icon-fallback {
    width: 100%;
    height: 100%;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.bp-health-bar__actions {
    position: absolute;
    flex-direction: row;
    flex-wrap: nowrap;
    align-self: center;
    width: 260px;
    height: 76px;
    padding: 0;
    justify-content: center;
    align-items: stretch;
    margin-bottom: 3px;
}
.bp-health-bar__action-btn {
    width: 58px;
    height: 58px;
    min-width: 58px;
    flex-shrink: 0;
    margin-left: 2px;
    margin-right: 2px;
    padding: 4px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(70, 120, 160, 0.8);
    background-color: rgba(12, 30, 50, 0.92);
    color: rgb(135, 200, 235);
    -unity-font-style: bold;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}
.bp-health-bar__actions .bp-health-bar__action-btn {
    width: 48px;
    min-width: 36px;
    height: 72px;
    flex-basis: 48px;
    flex-grow: 1;
    flex-shrink: 1;
    margin: 2px;
    padding: 2px;
}
.bp-health-bar__action-btn:hover {
    border-color: rgb(105, 205, 225);
    background-color: rgba(20, 60, 85, 0.96);
}
.bp-health-bar__action-btn--selected {
    border-color: rgb(95, 225, 155);
    background-color: rgba(25, 105, 70, 0.96);
    color: rgb(175, 245, 195);
}
.bp-health-bar__action-btn--passive {
    border-color: rgba(90, 100, 110, 0.55);
    background-color: rgba(35, 42, 48, 0.8);
    color: rgb(125, 135, 145);
}
.bp-health-bar__action-btn--enemy {
    border-color: rgba(190, 110, 75, 0.95);
    background-color: rgba(95, 42, 24, 0.92);
    color: rgb(255, 210, 170);
}
.bp-health-bar__action-btn--enemy:hover {
    border-color: rgb(230, 145, 100);
    background-color: rgba(125, 58, 32, 0.96);
}
.bp-health-bar__action-btn-icon {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    font-size: 11px;
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0.3);
    -unity-text-align: middle-center;
}
.bp-health-bar__actions .bp-health-bar__action-btn-icon {
    width: 100%;
    height: 50px;
    min-height: 50px;
    flex-grow: 0;
    flex-shrink: 0;
}
.bp-health-bar__action-btn-strength {
    width: 100%;
    height: 12px;
    flex-shrink: 0;
    margin-top: 2px;
    font-size: 8px;
    color: rgb(220, 235, 245);
    -unity-text-align: middle-center;
    white-space: nowrap;
}
.bp-health-bar__name {
    font-size: 20px;
    color: rgb(160, 200, 230);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    margin-bottom: 2px;
}
.bp-health-bar__track {
    height: 8px;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 4px;
    overflow: hidden;
    border-color: rgba(50, 100, 140, 0.5);
    border-width: 1px;
}
.bp-health-bar__fill {
    position: absolute;
    top: 0; left: 0; bottom: 0;
    width: 100%;
    background-color: rgb(40, 200, 120);
    border-radius: 3px;
    transition-property: width;
    transition-duration: 0.2s;
}
.bp-health-bar__fill--low {
    background-color: rgb(220, 180, 40);
}
.bp-health-bar__fill--critical {
    background-color: rgb(220, 60, 60);
}
.bp-health-bar__hp-text {
    font-size: 20px;
    color: rgb(120, 170, 200);
    -unity-text-align: upper-center;
    margin-top: 2px;
}

.bp-health-bar__energy {
    font-size: 9px;
    color: rgb(125, 220, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 2px;
}
.bp-health-bar__action-cost {
    position: absolute;
    left: -3px;
    top: -5px;
    width: 19px;
    height: 19px;
    border-radius: 10px;
    border-width: 1px;
    border-color: rgb(155, 225, 255);
    background-color: rgb(25, 100, 155);
    color: white;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.bp-health-bar__action-cooldown {
    position: absolute;
    left: 0;
    right: 0;
    top: 17px;
    height: 24px;
    background-color: rgba(15, 10, 30, 0.95);
    color: rgb(235, 190, 255);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.bp-health-bar__action-btn--cooldown {
    border-color: rgb(150, 100, 185);
}
.bp-health-bar__action-btn--no-energy {
    border-color: rgb(90, 100, 115);
    opacity: 0.55;
}
.bp-end-turn-btn {
    align-self: flex-end;
    width: 155px;
    height: 36px;
    margin-top: 4px;
    margin-bottom: 4px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(95, 210, 180);
    background-color: rgb(20, 75, 65);
    color: rgb(195, 250, 225);
    -unity-font-style: bold;
}
.bp-end-turn-btn:hover {
    background-color: rgb(30, 105, 85);
}
