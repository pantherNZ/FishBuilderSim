/* Full-screen result overlay */
.gep-overlay {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.76);
}

.gep-modal {
    width: 82%;
    max-width: 820px;
    min-width: 300px;
    max-height: 90%;
    background-color: rgb(8, 18, 30);
    border-color: rgb(30, 80, 120);
    border-width: 2px;
    border-radius: 12px;
    padding: 30px 34px 26px;
    align-items: center;
}

.gep-title {
    font-size: 46px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    letter-spacing: 4px;
    margin-bottom: 6px;
}

.gep-title--win {
    color: rgb(100, 235, 150);
}

.gep-title--loss {
    color: rgb(245, 115, 105);
}

.gep-message {
    font-size: 14px;
    color: rgb(160, 195, 220);
    -unity-text-align: upper-center;
    margin-bottom: 26px;
}

.gep-loot-title {
    font-size: 12px;
    color: rgb(120, 200, 255);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    letter-spacing: 2px;
    margin-bottom: 12px;
}

.gep-loot-row {
    width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    margin-bottom: 20px;
}

.gep-empty-loot {
    font-size: 12px;
    color: rgb(110, 145, 170);
    -unity-text-align: upper-center;
    margin-bottom: 20px;
}

.gep-loot-card {
    width: 180px;
    min-height: 190px;
    margin: 0 7px 10px;
    padding: 10px 8px;
    align-items: center;
    background-color: rgba(12, 35, 60, 0.95);
    border-width: 2px;
    border-radius: 8px;
}

.gep-rarity--common {
    border-color: rgb(120, 120, 120);
}

.gep-rarity--uncommon {
    border-color: rgb(60, 180, 80);
}

.gep-rarity--rare {
    border-color: rgb(40, 120, 220);
}

.gep-rarity--epic {
    border-color: rgb(160, 60, 220);
}

.gep-rarity--legendary {
    border-color: rgb(220, 160, 30);
}

.gep-loot-card__icon {
    width: 76px;
    height: 76px;
    margin-bottom: 8px;
    background-color: rgba(0, 0, 0, 0.35);
}

#gep-loot-card-name {
    font-size: 11px;
    color: rgb(220, 240, 255);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    white-space: normal;
    margin-bottom: 4px;
}

#gep-loot-card-rarity {
    font-size: 9px;
    color: rgb(155, 195, 230);
    -unity-text-align: upper-center;
    margin-bottom: 7px;
}

#gep-loot-card-stats {
    font-size: 9px;
    color: rgb(165, 225, 185);
    -unity-text-align: upper-center;
    white-space: normal;
    margin-bottom: 5px;
}

#gep-loot-card-description {
    font-size: 9px;
    color: rgb(145, 175, 195);
    -unity-text-align: upper-center;
    white-space: normal;
}

.gep-footer {
    width: 100%;
    align-items: center;
    justify-content: center;
}

.gep-primary-btn {
    min-width: 180px;
    font-size: 12px;
    padding: 8px 24px;
    border-radius: 5px;
    border-width: 1px;
    border-color: rgb(70, 170, 210);
    background-color: rgba(20, 85, 125, 0.9);
    color: rgb(205, 240, 255);
    letter-spacing: 1px;
}

.gep-primary-btn:hover {
    background-color: rgba(35, 125, 175, 0.95);
    border-color: rgb(110, 210, 240);
}
