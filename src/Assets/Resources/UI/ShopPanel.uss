.shop-overlay {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(4, 12, 20, 0.86);
}

.shop-modal {
    width: 92%;
    max-width: 1180px;
    max-height: 94%;
    padding: 26px 30px;
    background-color: rgb(8, 20, 29);
    border-width: 2px;
    border-color: rgb(48, 125, 145);
    border-radius: 10px;
}

.shop-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 18px;
}

.shop-title {
    color: rgb(125, 225, 208);
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.shop-subtitle {
    margin-top: 5px;
    color: rgb(135, 165, 175);
    font-size: 12px;
}

.shop-points {
    padding: 10px 14px;
    color: rgb(255, 216, 110);
    background-color: rgba(100, 72, 16, 0.35);
    border-width: 1px;
    border-color: rgb(160, 124, 42);
    border-radius: 5px;
    -unity-font-style: bold;
}

.shop-section-title {
    margin-bottom: 8px;
    color: rgb(112, 178, 193);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.shop-part-offers {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 18px;
}

.shop-part-card {
    width: 18%;
    min-width: 145px;
    min-height: 156px;
    margin: 4px;
    padding: 12px 10px;
    background-color: rgb(15, 38, 50);
    border-width: 2px;
    border-color: rgb(73, 115, 127);
    border-radius: 7px;
    align-items: center;
}

.shop-rarity-common { border-color: rgb(115, 135, 139); }
.shop-rarity-uncommon { border-color: rgb(68, 168, 106); }
.shop-rarity-rare { border-color: rgb(70, 137, 215); }
.shop-rarity-epic { border-color: rgb(177, 94, 205); }
.shop-rarity-legendary { border-color: rgb(221, 169, 61); }

#shop-card-name {
    max-width: 100%;
    color: rgb(226, 241, 240);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    white-space: normal;
}

#shop-card-rarity {
    margin-top: 5px;
    color: rgb(147, 190, 193);
    font-size: 9px;
    -unity-text-align: upper-center;
}

#shop-card-stats {
    min-height: 38px;
    margin-top: 10px;
    color: rgb(163, 202, 202);
    font-size: 9px;
    -unity-text-align: middle-center;
    white-space: normal;
}

#shop-buy-part,
#shop-buy-species {
    margin-top: auto;
    padding: 6px 9px;
    color: rgb(12, 29, 34);
    background-color: rgb(111, 215, 192);
    border-radius: 4px;
    -unity-font-style: bold;
    font-size: 10px;
}

#shop-buy-part:disabled,
#shop-buy-species:disabled {
    color: rgb(119, 145, 147);
    background-color: rgb(38, 59, 63);
}

.shop-species-header {
    flex-direction: row;
    align-items: baseline;
    justify-content: space-between;
}

.shop-species-empty {
    color: rgb(122, 151, 157);
    font-size: 11px;
}

.shop-species-offer {
    min-height: 112px;
    margin-bottom: 18px;
    padding: 14px 18px;
    background-color: rgb(17, 48, 57);
    border-width: 1px;
    border-color: rgb(58, 146, 151);
    border-radius: 7px;
}

#shop-species-name {
    color: rgb(225, 247, 237);
    font-size: 17px;
    -unity-font-style: bold;
}

#shop-species-kicker {
    margin-top: 3px;
    color: rgb(111, 215, 192);
    font-size: 10px;
    letter-spacing: 1px;
}

#shop-species-stats {
    margin-top: 10px;
    color: rgb(178, 215, 208);
    font-size: 11px;
    white-space: normal;
}

.shop-species-offer #shop-buy-species {
    align-self: flex-start;
}

.shop-leave {
    align-self: flex-end;
    padding: 8px 18px;
    color: rgb(176, 209, 211);
    background-color: rgb(27, 57, 66);
    border-width: 1px;
    border-color: rgb(68, 116, 123);
    border-radius: 4px;
    font-size: 11px;
    -unity-font-style: bold;
}

@media (max-width: 760px) {
    .shop-modal {
        width: 96%;
        padding: 18px;
    }

    .shop-header {
        flex-direction: column;
    }

    .shop-points {
        margin-top: 12px;
    }

    .shop-part-card {
        width: 45%;
        min-width: 130px;
    }
}
